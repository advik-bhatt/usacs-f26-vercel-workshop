# ─────────────────────────────────────────────────────────────────────────────
# You normally DON'T fill this in by hand. Add env vars / integrations in the
# Vercel dashboard, then run:   vercel env pull
# That writes .env.local with everything (including VERCEL_OIDC_TOKEN).
# This file just documents what each demo reads.
# ─────────────────────────────────────────────────────────────────────────────

# 06 Environment variables (slides 16–19: vercel env add GREETING)
GREETING=
# optional, for the client-side demo on /demos/env
NEXT_PUBLIC_WORKSHOP_GREETING=

# 07a Vercel Blob (added automatically when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=

# 07b Global Config (added when you connect the store to the project;
# EDGE_CONFIG also works)
GLOBAL_CONFIG=

# 07c Postgres via Marketplace (Neon) — added by the integration
DATABASE_URL=

# 07d Redis via Marketplace (Upstash) — added by the integration.
# Either the KV_* or UPSTASH_REDIS_* names work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 08 AI Gateway — either an API key (vercel ai-gateway api-keys create),
# or rely on VERCEL_OIDC_TOKEN below. The model is set in src/app/api/chat/route.ts.
AI_GATEWAY_API_KEY=

# 09 Cron — any long random string
CRON_SECRET=

# 11 Flags SDK — generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
FLAGS_SECRET=

# 14 Sandbox — set to "true" to allow the demo to boot microVMs
ENABLE_SANDBOX_DEMO=

# Written by `vercel env pull`. Short-lived (~12h) — pull again if you get 401s.
# Used by AI Gateway, Vercel Flags, Sandbox and Queues when running locally.
VERCEL_OIDC_TOKEN=
